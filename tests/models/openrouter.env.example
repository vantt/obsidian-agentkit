# OpenRouter settings for the E8 small-model runs (docs/plans/E8-small-models.md).
# Copy to ~/.config/obsidian-agentkit/openrouter.env (chmod 600) and fill in the key.
# Never commit the filled copy; the runner never prints these values.
# Plain KEY=value lines; quote values that contain spaces.

# Key from https://openrouter.ai/settings/keys. A key with its own credit limit
# is safest: OpenRouter then refuses calls past the limit on its side too.
OPENROUTER_API_KEY=

# Claude Code talks to OpenRouter's Anthropic-style endpoint (POST /api/v1/messages).
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Models under test, space separated (prices on 2026-10-23, USD per 1M tokens in / out).
#   deepseek/deepseek-v4.1-flash   0.165 / 0.66
#   deepseek/deepseek-v4-flash     0.091 / 0.182
#   z-ai/glm-5.3-flash             0.005 / 0.199
#   z-ai/glm-4.7-flash             0.061 / 0.40
# Claude models run on the Claude Code subscription, not through this key.
E8_MODELS="deepseek/deepseek-v4.1-flash deepseek/deepseek-v4-flash z-ai/glm-5.3-flash z-ai/glm-4.7-flash"

# Stop the run once the key's spend for E8 reaches this (USD).
E8_BUDGET_USD=40
